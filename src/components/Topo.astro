---
// Cabeçalho das páginas do blog, no mesmo desenho do topo da home.
const whatsapp =
  'https://wa.me/5551991006411?text=' +
  encodeURIComponent('Oi, Filipe! Li o blog da Seja e quero falar com um especialista sobre a divulgação da minha pesquisa.');
---
<header class="topo margem">
  <a href="/" aria-label="Seja Creator, início" class="simbolo"><img src="/assets/Simbolo_SEJA_BRANCO.webp" alt="" width="36" height="38"></a>
  <nav aria-label="Páginas" class="links">
    <a href="/">Início</a>
    <a href="/ciencia/">Divulgação científica</a>
    <a href="/blog/">Blog</a>
  </nav>
  <details class="menu-mobile">
    <summary aria-label="Abrir menu"><span class="hamburguer" aria-hidden="true"><span></span><span></span><span></span></span><span class="sr">Menu</span></summary>
    <nav aria-label="Menu">
      <a href="/">Início</a>
      <a href="/ciencia/">Divulgação científica</a>
      <a href="/blog/">Blog</a>
    </nav>
  </details>
  <a class="cta" href={whatsapp} target="_blank" rel="noopener">Falar com especialista</a>
</header>

<style>
.topo { position: relative; background: #8338EB; color: #FFFFFF; padding-top: 14px; padding-bottom: 14px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.simbolo { display: flex; }
.simbolo img { width: 36px; height: auto; display: block; }
.links { display: flex; gap: 32px; font-size: 17px; font-weight: 600; }
.links a { text-decoration: none; }
.links a:hover { text-decoration: underline; text-underline-offset: 6px; }
.cta { background: #FFFFFF; color: #8338EB; padding: 10px 22px; border-radius: 999px; font-weight: 800; font-size: 15px; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
.menu-mobile { display: none; }
.menu-mobile summary{list-style:none;cursor:pointer;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:12px}
.menu-mobile summary::-webkit-details-marker{display:none}
.menu-mobile summary:hover{background:rgba(255,255,255,.12)}
.hamburguer{position:relative;width:26px;height:18px;display:block}
.hamburguer span{position:absolute;left:0;height:3px;border-radius:3px;background:#FFFFFF;transition:transform .2s,opacity .2s,width .2s}
.hamburguer span:nth-child(1){top:0;width:26px}
.hamburguer span:nth-child(2){top:7.5px;width:18px}
.hamburguer span:nth-child(3){top:15px;width:26px}
.menu-mobile[open] .hamburguer span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.menu-mobile[open] .hamburguer span:nth-child(2){opacity:0}
.menu-mobile[open] .hamburguer span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}
@media (prefers-reduced-motion:reduce){.hamburguer span{transition:none}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.menu-mobile nav { position: absolute; left: 0; right: 0; top: 100%; z-index: 20; background: #8338EB; display: flex; flex-direction: column; padding: 8px clamp(20px, 5vw, 64px) 24px; border-top: 2px solid rgba(255, 255, 255, 0.25); }
.menu-mobile nav a { color: #FFFFFF; text-decoration: none; font-size: 22px; font-weight: 700; padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
@media (max-width: 860px) {
  .links, .cta { display: none; }
  .menu-mobile { display: block; }
}
</style>
