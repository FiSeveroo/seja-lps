<link rel="preload" href="/fonts/Futuru-Medium.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Futuru-Bold.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline>
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Semibold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Extrabold.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Futuru'; src: url('/fonts/Futuru-Black.woff2') format('woff2'); font-weight: 900; font-display: swap; }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --roxo: #8338EB;
    --rosa: #FF006E;
    --azul: #3A86FE;
    --laranja: #FB5507;
    --amarelo: #FFBE0C;
    --texto: #1A1A2E;
    --claro: #F5F4F8;
    --linha: #E6E3EE;
    --apoio: #55526A;
    --margem: clamp(20px, 5vw, 64px);
  }
  html { -webkit-text-size-adjust: 100%; }
  body {
    font-family: 'Futuru', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 500;
    color: var(--texto);
    background: #fff;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--azul); outline-offset: 3px; border-radius: 4px; }

  section { position: relative; overflow: hidden; padding: 120px var(--margem); }
  .container { max-width: 1160px; margin: 0 auto; position: relative; z-index: 2; }
  h1, h2, h3 { font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; text-wrap: balance; }
  h2 { font-size: clamp(32px, 4.2vw, 52px); margin-bottom: 28px; }
  h3 { font-size: 26px; line-height: 1.2; margin-bottom: 12px; }
  p { font-size: 19px; line-height: 1.65; margin-bottom: 16px; text-wrap: pretty; }
  .fonte { font-size: 15px; color: var(--apoio); }

  .cta {
    display: inline-block;
    background: var(--rosa);
    color: #fff;
    padding: 18px 34px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    transition: transform .2s ease, background-color .2s ease;
    touch-action: manipulation;
  }
  .cta:hover { transform: translateY(-2px); }
  .cta:active { transform: translateY(0); }
  .cta-branco { background: #fff; color: var(--rosa); }
  .cta-escuro { background: var(--texto); color: var(--amarelo); }
  .link-seta { font-weight: 700; color: var(--roxo); text-decoration: none; font-size: 18px; }
  .link-seta:hover { text-decoration: underline; text-underline-offset: 4px; }

  .simbolo-bg { position: absolute; z-index: 1; pointer-events: none; width: 820px; opacity: .07; }
  .simbolo-bg.dir { right: -220px; bottom: -260px; }
  .simbolo-bg.esq { left: -260px; top: -240px; }

  /* HERO */
  .hero {
    background: #5a3ee0 url('/assets/bg1.webp') center/cover no-repeat;
    color: #fff;
    text-align: center;
    padding: 72px var(--margem) 0;
  }
  .ilustra-topo { width: 100%; max-width: 1100px; height: auto; display: block; margin: 64px auto 0; }
  .hero-logo { width: 190px; margin: 0 auto 72px; }
  .hero h1 { font-size: clamp(40px, 6.2vw, 84px); max-width: 1000px; margin: 0 auto 32px; }
  .hero-sub { font-size: clamp(19px, 1.7vw, 23px); max-width: 720px; margin: 0 auto 44px; color: #fff; }

  /* DORES */
  .dores h2 { color: var(--roxo); max-width: 900px; margin-bottom: 40px; }
  .dores-lista { list-style: none; columns: 2; column-gap: 72px; }
  .dores-lista li { break-inside: avoid; }
  .dores-lista li {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 22px;
    align-items: center;
    padding: 26px 0;
    font-size: 21px;
    line-height: 1.5;
  }
  .dores-lista li { border-top: 2px solid var(--linha); }
  .dores-lista img { width: 60px; height: auto; }
  .dores-fechamento { margin-top: 28px; font-size: 21px; font-weight: 700; color: var(--roxo); }

  /* DADOS */
  .dados { background: var(--roxo); color: #fff; }
  .dados h2 { max-width: 760px; }
  .dados-intro { max-width: 720px; color: #fff; }
  .dados-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px; margin: 64px 0 56px; }
  .dado-num {
    font-size: clamp(64px, 7.5vw, 112px);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -0.04em;
    margin-bottom: 18px;
    font-variant-numeric: tabular-nums;
  }
  .dado p { font-size: 19px; color: #fff; margin-bottom: 12px; }
  .dado .fonte { color: #EDE3FF; font-size: 15px; }
  .dados-fechamento { max-width: 820px; font-size: 22px; font-weight: 600; color: #fff; margin: 0; }

  /* CAPES */
  .capes { background: var(--claro); text-align: center; }
  .capes h2 { color: var(--roxo); max-width: 820px; margin-left: auto; margin-right: auto; }
  .timeline { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 64px 0 48px; position: relative; list-style: none; }
  .timeline::before { content: ''; position: absolute; top: 56px; left: 12%; right: 12%; height: 4px; background: var(--linha); border-radius: 4px; }
  .etapa { position: relative; }
  .etapa-icone { width: 112px; margin: 0 auto 16px; position: relative; background: var(--claro); }
  .etapa-icone img { width: 100%; height: auto; display: block; }
  .etapa-ano { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
  .etapa-titulo { font-size: 19px; font-weight: 700; margin-bottom: 10px; }
  .etapa-texto { font-size: 17px; line-height: 1.55; color: var(--texto); margin: 0; }

  /* SERVIÇOS */
  .servicos h2 { color: var(--roxo); max-width: 760px; }
  .servicos-intro { max-width: 720px; }
  .servicos-lista { margin-top: 56px; }
  .servico {
    display: grid;
    grid-template-columns: 88px 4fr 7fr;
    gap: 36px;
    align-items: start;
    padding: 40px 0;
  }
  .servico + .servico { border-top: 2px solid var(--linha); }
  .servico img { width: 88px; height: auto; }
  .servico h3 { font-size: 34px; margin: 6px 0 0; }
  .servico p { margin-bottom: 8px; }
  .servico .link-seta { display: inline-block; margin-top: 8px; }

  /* EDITAIS */
  .editais { background: var(--amarelo); }
  .editais-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .editais h2 { font-size: clamp(30px, 3.4vw, 44px); }
  .editais p { color: var(--texto); }
  .editais .cta { margin-top: 12px; }
  .selo { display: flex; gap: 18px; align-items: center; background: var(--texto); color: #fff; padding: 22px 26px; border-radius: 16px; margin-top: 36px; }
  .selo img { width: 40px; flex-shrink: 0; }
  .selo p { color: #fff; font-size: 17px; margin: 0; line-height: 1.45; }
  .selo strong { display: block; font-size: 19px; color: var(--amarelo); }

  .doc { background: #fff; border-radius: 16px; padding: 40px 36px; position: relative; transform: rotate(-1.5deg); }
  .doc-aviso {
    position: absolute; top: -22px; right: -14px;
    background: var(--laranja); color: #fff;
    padding: 10px 18px; border-radius: 999px;
    font-size: 16px; font-weight: 700; transform: rotate(3deg); white-space: nowrap;
  }
  .doc-cabecalho { border-bottom: 2px solid var(--linha); padding-bottom: 16px; margin-bottom: 22px; }
  .doc-tipo { font-size: 14px; color: var(--apoio); margin-bottom: 4px; }
  .doc-titulo { font-size: 18px; font-weight: 700; }
  .campo { margin-bottom: 16px; }
  .campo-nome { font-size: 15px; font-weight: 600; color: var(--apoio); margin-bottom: 6px; }
  .campo-linha { height: 26px; border-radius: 6px; background: var(--claro); position: relative; }
  .campo-linha::after { content: ''; position: absolute; top: 9px; left: 12px; right: 40%; height: 8px; border-radius: 3px; background: #DAD7E2; }
  .campo-linha.curta::after { right: 62%; }
  .campo-linha.longa::after { right: 18%; }
  .campo-destaque { background: #FFF2E9; border: 3px solid var(--laranja); border-radius: 10px; padding: 16px; margin: 22px 0 18px; }
  .campo-destaque .campo-nome { color: var(--laranja); font-weight: 700; font-size: 16px; }
  .campo-destaque .campo-linha { background: #fff; height: 54px; }
  .campo-destaque .campo-linha::after { display: none; }

  /* PERGUNTAS FREQUENTES */
  .faq { background: var(--roxo); color: #fff; }
  .faq-container { max-width: 1160px; display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: 72px; align-items: start; }
  .ilustra-perguntas { width: 100%; height: auto; display: block; position: sticky; top: 40px; }
  .faq h2 { color: #fff; margin-bottom: 40px; }
  .faq-lista { border-top: 2px solid rgba(255,255,255,.3); }
  .faq details { border-bottom: 2px solid rgba(255,255,255,.3); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 0; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary h3 { font-size: clamp(20px, 2vw, 24px); margin: 0; color: #fff; }
  .faq-mais { position: relative; flex-shrink: 0; width: 22px; height: 22px; }
  .faq-mais::before, .faq-mais::after { content: ""; position: absolute; left: 0; top: 10px; width: 22px; height: 3px; border-radius: 3px; background: #fff; }
  .faq-mais::after { transform: rotate(90deg); transition: transform .2s ease; }
  .faq details[open] .faq-mais::after { transform: rotate(0deg); }
  .faq details p { color: #fff; margin: 0 0 28px; max-width: 760px; }
  @media (prefers-reduced-motion: reduce) { .faq-mais::after { transition: none; } }


  /* CTA FINAL */
  .cta-final { background: var(--rosa); color: #fff; text-align: center; padding: 140px var(--margem); }
  .cta-final h2 { font-size: clamp(44px, 6vw, 80px); margin-bottom: 24px; }
  .cta-final p { max-width: 600px; margin: 0 auto 40px; color: #fff; font-size: 20px; }

  footer { background: #0F0A1F; color: #C9C4D9; text-align: center; padding: 56px var(--margem); font-size: 15px; }
  footer img { width: 130px; margin: 0 auto 18px; }

  /* Entrada suave dos blocos */
  .revela { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  .revela.visivel { opacity: 1; transform: none; }
  .sem-js .revela { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .revela { opacity: 1; transform: none; transition: none; }
    .cta { transition: none; }
  }

  @media (max-width: 960px) {
    .faq-container { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .ilustra-perguntas { position: static; max-width: 340px; }
    section { padding: 80px var(--margem); }
    .editais-grid { grid-template-columns: 1fr; gap: 40px; }
    .dores-lista { columns: 1; }
    .dados-grid { grid-template-columns: 1fr; gap: 40px; margin: 48px 0 40px; }
    .timeline { grid-template-columns: 1fr 1fr; gap: 40px 24px; }
    .timeline::before { display: none; }
    .servico { grid-template-columns: 64px 1fr; gap: 12px 20px; }
    .servico img { width: 64px; }
    .servico > div:last-child { grid-column: 2; }
    .servico h3 { font-size: 28px; margin-top: 4px; }
    .doc { transform: none; margin-top: 16px; }
  }
  @media (max-width: 560px) {
    p { font-size: 18px; }
    .hero { padding: 48px var(--margem) 0; }
    .ilustra-topo { margin-top: 48px; }
    .hero-logo { width: 150px; margin-bottom: 56px; }
    .hero h1 { font-size: 38px; }
    .dores-lista li { font-size: 19px; grid-template-columns: 48px 1fr; gap: 16px; }
    .dores-lista img { width: 48px; }
    .timeline { grid-template-columns: 1fr; }
    .doc { padding: 32px 22px; }
    .doc-aviso { right: 8px; font-size: 14px; }
    .simbolo-bg { width: 480px; }
    .cta { padding: 17px 28px; font-size: 17px; }
  }
</style>
</head>
<body class="sem-js">

<main>
<!-- HERO -->
<section class="hero">
  <img class="simbolo-bg dir" src="/assets/Simbolo_SEJA_BRANCO.webp" alt="" aria-hidden="true" width="800" height="838">
  <div class="container">
    <img class="hero-logo" src="/assets/Logotipo_SEJA_BRANCO.webp" alt="Seja Creator" width="1000" height="486" fetchpriority="high">
    <h1>A ciência que você faz precisa chegar em quem importa.</h1>
    <p class="hero-sub">A Seja é especializada em divulgação científica nas plataformas digitais. Caminhamos ao lado de pesquisadores, grupos de pesquisa, programas de pós-graduação e projetos de pesquisa na estratégia, na criação e na gestão da presença digital.</p>
    <a class="cta" href="https://wa.me/5551991006411?text=Oi%2C%20Filipe!%20Vi%20a%20p%C3%A1gina%20da%20Seja%20e%20quero%20conversar." target="_blank" rel="noopener">Falar com especialista</a>
    <img class="ilustra-topo" src="/assets/ilustra-ciencia-topo-v1.svg" width="1200" height="640" alt="Ilustração de uma pesquisadora falando, com notebook e livros na mesa. A ideia dela, uma lâmpada acesa, passa por um vídeo, um podcast e um post e chega a pessoas de várias idades do outro lado da mesa, uma delas com o celular na mão.">
  </div>
</section>

<!-- DORES -->
<section class="dores">
  <div class="container">
    <h2 class="revela">Se você é pesquisador, provavelmente já passou por isso.</h2>
    <div class="revela">
      <ul class="dores-lista">
        <li><img src="/assets/ilustra-ciencia-dor-alcance-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"><span>Sabe que o que você estuda importa, mas não sabe como fazer isso chegar em quem não é da área.</span></li>
        <li><img src="/assets/ilustra-ciencia-dor-tempo-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"><span>Quer aparecer nas redes, mas não sabe por onde começar, e não tem tempo pra descobrir sozinho.</span></li>
        <li><img src="/assets/ilustra-ciencia-dor-tom-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"><span>Já tentou publicar conteúdo, mas o que sai técnico demais não é lido, e o que sai simples demais parece raso.</span></li>
        <li><img src="/assets/ilustra-ciencia-dor-rotina-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"><span>Vê colegas construindo audiência e se pergunta como conciliar isso com a rotina de pesquisa, aula e orientação.</span></li>
        <li><img src="/assets/ilustra-ciencia-dor-impacto-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"><span>Precisa mostrar o impacto do seu trabalho pra editais, avaliações institucionais e agora pra CAPES, mas sente que a academia não te preparou pra isso.</span></li>
      </ul>
      <p class="dores-fechamento">A gente entende essas dores porque trabalha com elas todo dia.</p>
    </div>
  </div>
</section>

<!-- DADOS -->
<section class="dados">
  <img class="simbolo-bg esq" src="/assets/Simbolo_SEJA_BRANCO.webp" alt="" aria-hidden="true" width="800" height="838" loading="lazy">
  <div class="container">
    <h2 class="revela">Você não está sozinho nessa.</h2>
    <p class="dados-intro revela">Os dados mostram que o problema é estrutural. A academia forma pesquisadores excelentes, mas raramente prepara alguém pra comunicar ciência fora dos próprios pares.</p>
    <div class="dados-grid">
      <div class="dado revela">
        <div class="dado-num">82,5%</div>
        <p>dos pesquisadores envolvidos com divulgação científica na USP, Unesp e Unicamp nunca receberam treinamento pra comunicar ciência.</p>
        <p class="fonte">Flores e Barata, Labjor/Unicamp (2019), citado no The Conversation</p>
      </div>
      <div class="dado revela">
        <div class="dado-num">97,4%</div>
        <p>dos cientistas ouvidos gostariam de divulgar mais os seus trabalhos acadêmicos.</p>
        <p class="fonte">Righetti et al., Agência Bori (2021), pesquisa com 1.681 cientistas feita em 2019</p>
      </div>
      <div class="dado revela">
        <div class="dado-num">70,8%</div>
        <p>dos cientistas ouvidos dizem que não há procedimento previsto na instituição para comunicar um trabalho aceito ou publicado.</p>
        <p class="fonte">Righetti et al., Agência Bori (2021), pesquisa com 1.681 cientistas feita em 2019</p>
      </div>
    </div>
    <p class="dados-fechamento revela">Cientistas querendo se comunicar e instituições sem um caminho pra isso. No ciclo 2025 a 2028, impacto e inovação entra na nota de cada programa.</p>
  </div>
</section>

<!-- CAPES -->
<section class="capes">
  <div class="container">
    <h2 class="revela">Comunicar ciência deixou de ser opcional.</h2>
    <ol class="timeline">
      <li class="etapa revela">
        <div class="etapa-icone"><img src="/assets/ilustra-ciencia-capes-qualis-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"></div>
        <div class="etapa-ano">Até 2024</div>
        <div class="etapa-titulo">Lista Qualis</div>
        <p class="etapa-texto">A CAPES publicava a lista de revistas com nota Qualis Periódicos.</p>
      </li>
      <li class="etapa laranja revela">
        <div class="etapa-icone"><img src="/assets/ilustra-ciencia-capes-artigo-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"></div>
        <div class="etapa-ano">2025</div>
        <div class="etapa-titulo">Novo ciclo</div>
        <p class="etapa-texto">A lista de revistas deixa de ser publicada e a classificação passa a ser do artigo. Cada programa é avaliado em três quesitos: estrutura; formação, pesquisa e produção intelectual; impacto e inovação.</p>
      </li>
      <li class="etapa revela">
        <div class="etapa-icone"><img src="/assets/ilustra-ciencia-capes-coleta-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"></div>
        <div class="etapa-ano">2025 a 2028</div>
        <div class="etapa-titulo">Ciclo avaliativo</div>
        <p class="etapa-texto">Coleta de dados anual. O que o programa faz nesses quatro anos entra na avaliação.</p>
      </li>
      <li class="etapa roxo revela">
        <div class="etapa-icone"><img src="/assets/ilustra-ciencia-capes-quadrienal-v1.svg" alt="" aria-hidden="true" width="120" height="120" loading="lazy"></div>
        <div class="etapa-ano">2029</div>
        <div class="etapa-titulo">Avaliação Quadrienal</div>
        <p class="etapa-texto">Notas de 1 a 7. Notas 1 e 2 levam à desativação do programa.</p>
      </li>
    </ol>
