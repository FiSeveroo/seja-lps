<style is:inline>
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
img { max-width: 100%; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
@font-face{font-family:'Futuru';src:url('/fonts/Futuru-Medium.woff2') format('woff2');font-weight:500;font-display:swap}
@font-face{font-family:'Futuru';src:url('/fonts/Futuru-Semibold.woff2') format('woff2');font-weight:600;font-display:swap}
@font-face{font-family:'Futuru';src:url('/fonts/Futuru-Bold.woff2') format('woff2');font-weight:700;font-display:swap}
@font-face{font-family:'Futuru';src:url('/fonts/Futuru-Extrabold.woff2') format('woff2');font-weight:800;font-display:swap}
@font-face{font-family:'Futuru';src:url('/fonts/Futuru-Black.woff2') format('woff2');font-weight:900;font-display:swap}
body{margin:0}
a{color:inherit}
a:hover{opacity:.85}
:focus-visible{outline:3px solid #3A86FE;outline-offset:3px;border-radius:4px}
.hero{background:#5a3ee0 url('/assets/bg1.webp') center/cover no-repeat}
.grade-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px}
.grade-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:56px}
.acordeao summary{list-style:none;cursor:pointer}
.acordeao summary::-webkit-details-marker{display:none}
.mais{flex-shrink:0}
details[open] .mais .vertical{display:none}
.menu-mobile{display:none}
.menu-mobile summary{list-style:none;cursor:pointer;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:12px}
.menu-mobile summary::-webkit-details-marker{display:none}
.menu-mobile summary:hover{background:rgba(255,255,255,.12)}
.hamburguer{position:relative;width:26px;height:18px;display:block}
.hamburguer span{position:absolute;left:0;height:3px;border-radius:3px;background:#FFFFFF;transition:transform .2s,opacity .2s,width .2s}
.hamburguer span:nth-child(1){top:0;width:26px}
.hamburguer span:nth-child(2){top:7.5px;width:18px}
.hamburguer span:nth-child(3){top:15px;width:26px}
.menu-mobile[open] .hamburguer span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.menu-mobile[open] .hamburguer span:nth-child(2){opacity:0}
.menu-mobile[open] .hamburguer span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}
@media (prefers-reduced-motion:reduce){.hamburguer span{transition:none}}
.banner-pessoas{padding:0 clamp(20px,5vw,64px) 120px}
.banner-pessoas img{display:block;width:100%;max-width:1160px;height:auto;aspect-ratio:21/6;margin:0 auto;border-radius:24px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.menu-mobile nav{position:absolute;left:0;right:0;top:100%;z-index:20;background:#8338EB;display:flex;flex-direction:column;padding:8px clamp(20px,5vw,64px) 24px;border-top:2px solid rgba(255,255,255,.25)}
.menu-mobile nav a{color:#FFFFFF;text-decoration:none;font-size:22px;font-weight:700;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.2)}
@media (max-width:900px){
  .menu-mobile{display:block}
  .cta-topo{display:none !important}
  .grade-2,.grade-3{grid-template-columns:minmax(0,1fr);gap:40px}
  .nav-links{display:none !important}
  .marca{font-size:52px !important}
  h2:not(.marca){font-size:32px !important}
  .capa-foto{min-height:520px !important}
  .numeros{grid-template-columns:minmax(0,1fr) !important;gap:12px !important}
  .numeros>div{display:grid;grid-template-columns:150px minmax(0,1fr);align-items:baseline;gap:12px}
  .numeros>div>div:first-child{white-space:nowrap}
  .numeros>div>div:last-child{margin-top:0 !important;font-size:16px !important}
  .so-desktop{display:none !important}
  .secao{padding:80px 20px !important}
  .banner-pessoas{padding:0 0 80px}
  .banner-pessoas img{border-radius:0}
}
</style>
</head>
<body>
<div style="font-family: 'Futuru', -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 500; color: #1A1A2E; background: #FFFFFF; line-height: 1.6; -webkit-font-smoothing: antialiased;">

<header class="topo" style="position: relative; background: #8338EB; color: #FFFFFF; padding: 14px clamp(20px, 5vw, 64px); display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;">
  <a href="#topo" aria-label="Seja Creator, início" style="display: flex; align-items: center; text-decoration: none;"><img loading="lazy" src="/assets/Simbolo_SEJA_BRANCO.webp" width="800" height="838" alt="" style="width: 36px; height: auto; display: block;"></a>
  <nav class="nav-links" aria-label="Seções" style="display: flex; gap: 32px; font-size: 17px; font-weight: 600;">
    <a href="#o-que-fazemos" style="text-decoration: none;">O que fazemos</a>
    <a href="#historias" style="text-decoration: none;">Histórias</a>
    <a href="#editais" style="text-decoration: none;">Editais</a>
    <a href="#formacao" style="text-decoration: none;">Formação</a>
    <a href="#feito-por" style="text-decoration: none;">Quem somos</a>
    <a href="/blog/" style="text-decoration: none;">Blog</a>
  </nav>
  <details class="menu-mobile">
    <summary aria-label="Abrir menu"><span class="hamburguer" aria-hidden="true"><span></span><span></span><span></span></span><span class="sr">Menu</span></summary>
    <nav aria-label="Menu">
      <a href="#o-que-fazemos">O que fazemos</a>
      <a href="#historias">Histórias</a>
      <a href="#editais">Editais</a>
      <a href="#formacao">Formação</a>
      <a href="#feito-por">Quem somos</a>
      <a href="/blog/">Blog</a>
    </nav>
  </details>
  <a class="cta-topo" href="https://wa.me/5551991006411?text=Oi%2C%20Filipe%21%20Vi%20o%20site%20da%20Seja%20e%20quero%20conversar%20sobre%20a%20divulga%C3%A7%C3%A3o%20da%20minha%20pesquisa." target="_blank" rel="noopener" style="background: #FFFFFF; color: #8338EB; padding: 10px 22px; border-radius: 999px; font-weight: 800; font-size: 15px; text-transform: uppercase; text-decoration: none;">Falar com especialista</a>
</header>
<main>

<section id="topo" class="hero secao" style="position: relative; overflow: hidden; color: #FFFFFF; text-align: center; padding: 96px clamp(20px, 5vw, 64px) 140px;">
  <img loading="lazy" class="so-desktop" src="/assets/Simbolo_SEJA_BRANCO.webp" width="800" height="838" alt="" aria-hidden="true" style="position: absolute; width: 820px; height: auto; right: -220px; bottom: -260px; opacity: 0.07; pointer-events: none;">
  <div style="position: relative; max-width: 1200px; margin: 0 auto;">
    <h1 class="h1" style="font-size: clamp(52px, 9.2vw, 132px); font-weight: 800; letter-spacing: -0.035em; line-height: 1; margin: 0 auto 32px; text-wrap: balance;">Plataformas a favor da ciência.</h1>
    <p style="font-size: clamp(24px, 3.2vw, 44px); font-weight: 600; line-height: 1.25; max-width: 900px; margin: 0 auto 48px; text-wrap: balance;">Especialistas em divulgação científica digital.</p>
    <a href="https://wa.me/5551991006411?text=Oi%2C%20Filipe%21%20Vi%20o%20site%20da%20Seja%20e%20quero%20conversar%20sobre%20a%20divulga%C3%A7%C3%A3o%20da%20minha%20pesquisa." target="_blank" rel="noopener" style="display: inline-block; background: #FF006E; color: #FFFFFF; padding: 18px 34px; border-radius: 999px; font-weight: 700; font-size: 18px; text-decoration: none;">Falar com especialista</a>
  </div>
</section>

<section id="o-que-fazemos" class="secao" style="padding: 120px clamp(20px, 5vw, 64px);">
  <div class="grade-2" style="max-width: 1160px; margin: 0 auto; align-items: center;">
    <div>
      <img loading="lazy" class="so-desktop" src="/assets/Logotipo_SEJA_ROXO.webp" width="1000" height="486" alt="" aria-hidden="true" style="width: 100%; max-width: 520px; height: auto; display: block; margin-bottom: 40px;">
      <h2 style="font-size: 36px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; color: #8338EB; margin: 0; text-wrap: balance;">Formação, planos de divulgação e presença digital para quem pesquisa.</h2>
    </div>
    <div>
      <details class="acordeao" name="servicos" open style="border: 1px solid #8338EB; margin-bottom: 16px;">
        <summary style="display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 32px; font-weight: 800; font-size: 24px; text-transform: uppercase; color: #8338EB;">Projeto <svg class="mais" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 11h16"></path><path class="vertical" d="M11 3v16"></path></svg></summary>
        <div style="padding: 0 32px 28px; font-size: 19px;">Trabalho com escopo e prazo definidos. Para objetivos específicos: lançamento, edital, campanha ou base inicial.</div>
      </details>
      <details class="acordeao" name="servicos" style="border: 1px solid #8338EB; margin-bottom: 16px">
        <summary style="display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 32px; font-weight: 800; font-size: 24px; text-transform: uppercase; color: #8338EB;">Parceria contínua <svg class="mais" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 11h16"></path><path class="vertical" d="M11 3v16"></path></svg></summary>
        <div style="padding: 0 32px 28px; font-size: 19px">Caminhada de longo prazo com pesquisadores, grupos de pesquisa, programas de pós-graduação e projetos de pesquisa. Estratégia, planejamento, criação e gestão das plataformas.</div>
      </details>
      <details class="acordeao" name="servicos" style="border: 1px solid #8338EB; margin-bottom: 16px;">
        <summary style="display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 32px; font-weight: 800; font-size: 24px; text-transform: uppercase; color: #8338EB;">Editais <svg class="mais" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 11h16"></path><path class="vertical" d="M11 3v16"></path></svg></summary>
        <div style="padding: 0 32px 28px; font-size: 19px;">Construímos junto com você o plano de divulgação científica e impacto social da proposta. Do documento pro edital ao trabalho contínuo depois da aprovação. <a href="https://wa.me/5551991006411?text=Oi%2C%20Filipe%21%20Vi%20o%20site%20da%20Seja%20e%20meu%20edital%20pede%20plano%20de%20divulga%C3%A7%C3%A3o%20cient%C3%ADfica." target="_blank" rel="noopener" style="font-weight: 700; color: #8338EB; text-decoration: none;">Falar sobre meu edital →</a></div>
      </details>
      <details class="acordeao" name="servicos" style="border: 1px solid #8338EB;">
        <summary style="display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 32px; font-weight: 800; font-size: 24px; text-transform: uppercase; color: #8338EB;">Formação <svg class="mais" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 11h16"></path><path class="vertical" d="M11 3v16"></path></svg></summary>
        <div style="padding: 0 32px 28px; font-size: 19px;">Pra quem quer aprender a comunicar a própria ciência, individualmente ou em grupo de pesquisa.</div>
      </details>
    </div>
  </div>
</section>

<div class="banner-pessoas">
  <img loading="lazy" src="/assets/ilustracao-pesquisa-e-publico.webp" width="1824" height="521" alt="Ilustração: pesquisadoras e pesquisadores de um lado e pessoas do público do outro, ligados por balões com um livro, um vídeo no celular, um microfone de podcast e uma apresentação.">
</div>

<section class="secao" style="position: relative; overflow: hidden; background: #8338EB; color: #FFFFFF; padding: 120px clamp(20px, 5vw, 64px);">
  <img loading="lazy" class="so-desktop" src="/assets/Simbolo_SEJA_BRANCO.webp" width="800" height="838" alt="" aria-hidden="true" style="position: absolute; width: 820px; height: auto; left: -260px; top: -240px; opacity: 0.07; pointer-events: none;">
  <div style="position: relative; max-width: 1160px; margin: 0 auto;">
    <h2 style="font-size: 52px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; margin: 0 0 24px; max-width: 820px; text-wrap: balance;">Comunicar ciência deixou de ser opcional.</h2>
    <p style="font-size: 19px; max-width: 760px; margin: 0;">No ciclo 2025 a 2028, impacto e inovação é um dos três quesitos de avaliação de cada programa de pós-graduação. E muitas vezes nem há um caminho pra isso dentro da instituição.</p>
    <p style="font-size: 15px; color: #EDE3FF; margin: 8px 0 0;">CAPES, Portaria nº 109/2025, art. 12</p>
    <div class="grade-3" style="margin: 64px 0 48px;">
      <div>
        <div style="font-size: 104px; font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 18px;">82,5%</div>
        <p style="font-size: 19px; margin: 0 0 12px;">dos pesquisadores envolvidos com divulgação científica na USP, Unesp e Unicamp nunca receberam treinamento pra comunicar ciência.</p>
        <p style="font-size: 15px; color: #EDE3FF; margin: 0;">Flores e Barata, Labjor/Unicamp (2019), citado no The Conversation</p>
      </div>
      <div>
        <div style="font-size: 104px; font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 18px;">97,4%</div>
        <p style="font-size: 19px; margin: 0 0 12px;">dos cientistas ouvidos gostariam de divulgar mais os seus trabalhos acadêmicos.</p>
        <p style="font-size: 15px; color: #EDE3FF; margin: 0;">Righetti et al., Agência Bori (2021), pesquisa com 1.681 cientistas feita em 2019</p>
      </div>
      <div>
        <div style="font-size: 104px; font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 18px;">70,8%</div>
        <p style="font-size: 19px; margin: 0 0 12px;">dos cientistas ouvidos dizem que não há procedimento previsto na instituição para comunicar um trabalho aceito ou publicado.</p>
        <p style="font-size: 15px; color: #EDE3FF; margin: 0;">Righetti et al., Agência Bori (2021), pesquisa com 1.681 cientistas feita em 2019</p>
      </div>
    </div>
    <a href="/ciencia/" style="font-weight: 700; font-size: 18px; color: #FFFFFF; text-underline-offset: 4px;">Entender a mudança da CAPES →</a>
  </div>
</section>

<section id="historias" class="secao" style="position: relative; overflow: hidden; background: #FB5507; padding: 120px clamp(20px, 5vw, 64px);">
  <div style="position: relative; max-width: 1160px; margin: 0 auto;">
    <h2 class="marca" style="font-size: 120px; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 0.95; color: #FFFFFF; text-align: center; margin: 0 0 16px;">Histórias</h2>
    <p style="font-size: 23px; font-weight: 700; color: #FFFFFF; text-align: center; margin: 0 0 64px;">que ajudamos a contar</p>
    <article class="grade-2" style="gap: 0; background: #FFFFFF; border-radius: 20px; overflow: hidden;">
      <div class="capa-foto" style="position: relative; overflow: hidden; background: #1A1A2E; min-height: 460px;">
        <div class="carrossel" tabindex="0" aria-label="Fotos do Nós da Docência" style="position: absolute; inset: 0;">
          <img src="/assets/maria-claudia-daligna.webp" width="900" height="900" alt="Maria Cláudia Dal’Igna" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 15%; display: block; opacity: 1; transition: opacity 0.8s ease;">
          <img src="/assets/nos-da-docencia-podcast.webp" width="793" height="800" alt="Maria Cláudia gravando o podcast Nós da Docência" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; opacity: 0; transition: opacity 0.8s ease;">
          <img src="/assets/nos-da-docencia-livro.webp" width="793" height="800" alt="Capa do livro Nós da Docência" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; opacity: 0; transition: opacity 0.8s ease;">
          <img src="/assets/nos-da-docencia-gravacao.webp" width="793" height="800" alt="Gravação em estúdio do Nós da Docência" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; opacity: 0; transition: opacity 0.8s ease;">
        </div>
        <div style="position: absolute; left: 20px; right: 20px; bottom: 20px; pointer-events: none;">
          <div style="display: inline-block; background: #FF006E; color: #FFFFFF; border-radius: 14px; padding: 16px 20px;">
            <div style="font-size: 36px; font-weight: 800; letter-spacing: -0.03em; line-height: 1;">Nós da Docência</div>
            <div style="font-size: 19px; font-weight: 700; margin-top: 8px;">Maria Cláudia Dal’Igna, doutora em Educação (Unisinos)</div>
          </div>
        </div>
      </div>
      <div style="padding: 40px; display: flex; flex-direction: column; justify-content: center;">
        <h3 style="font-size: 30px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; color: #1A1A2E; margin: 0 0 14px;">Da ideia ao ecossistema inteiro, construído junto.</h3>
        <p style="font-size: 18px; margin: 0 0 28px;">Desde 2024, a Seja construiu com a Maria Cláudia a marca, o site, as redes, os materiais, o modelo de negócio e a plataforma de formação continuada do Nós da Docência.</p>
        <div class="numeros" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; border-top: 2px solid #E6E3EE; padding-top: 20px;">
